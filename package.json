{
  "name": "seasonal-spirits",
  "version": "0.0.0",
  "private": true,
  "description": "Seasonal Spirits — a real-time team game for the Seasonal Entertainment community.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "e2e": "playwright test -c apps/client/e2e/playwright.config.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify:changed": "node scripts/verify-changed.mjs",
    "server": "pnpm --filter @seasonal-spirits/server start",
    "viewer": "pnpm --filter @seasonal-spirits/viewer start",
    "client": "pnpm --filter @seasonal-spirits/client start",
    "probe": "pnpm --filter @seasonal-spirits/probe start",
    "simulate": "pnpm --filter @seasonal-spirits/game-core simulate",
    "settings:doc": "pnpm --filter @seasonal-spirits/game-core settings:doc",
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev.mjs stop",
    "review:capture": "pnpm --filter @seasonal-spirits/review-capture start",
    "review:sheets": "pnpm --filter @seasonal-spirits/review-capture sheets"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
