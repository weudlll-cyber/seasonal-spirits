// Seasonal Spirits — strict TypeScript base shared by every workspace project.
// One set of compiler checks, aligned with seasonal-mini-games; NodeNext resolution for the
// server, the protocol and the probe. The browser viewer extends tsconfig.bundler.json.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // No ambient @types leak into a project; each one opts in to what it needs (e.g. node).
    "types": []
  }
}
